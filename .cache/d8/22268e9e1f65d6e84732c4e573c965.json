/script_home.js","original":{"line":44,"column":4}},{"generated":{"line":42,"column":8},"source":"src/scripts/script_home.js","original":{"line":44,"column":10}},{"generated":{"line":43,"column":0},"source":"src/scripts/script_home.js","original":{"line":45,"column":1}},{"name":"app","generated":{"line":45,"column":0},"source":"src/scripts/script_home.js","original":{"line":47,"column":0}},{"generated":{"line":45,"column":3},"source":"src/scripts/script_home.js","original":{"line":47,"column":3}}],"sources":{"src/scripts/script_home.js":"function slider() {\r\n    const slides = document.querySelectorAll('.slide-picture');\r\n    const indicators = document.querySelectorAll('.slider-indicator');\r\n    const title = document.querySelector('.img-title');\r\n    const descr = document.querySelector('.img-desc');\r\n\r\n    function reset() {\r\n        slides.forEach(el => {\r\n            el.classList.remove('current');\r\n        });\r\n        indicators.forEach(el => {\r\n            el.classList.remove('active');\r\n        });\r\n    }\r\n\r\n    indicators.forEach(el => {\r\n        el.addEventListener('click' , () => {\r\n            reset();\r\n            const cur = el.dataset.slideTo;\r\n            const curSlide = slides[cur];\r\n            const curImg = curSlide.children[0];\r\n            const head = curImg.dataset.header;\r\n            const desc = curImg.dataset.description;\r\n            \r\n            el.classList.add('active');\r\n            curSlide.classList.add('current');\r\n            title.textContent = head;\r\n            descr.textContent = desc;\r\n        })\r\n    })\r\n}\r\n\r\nfunction navbar() {\r\n    const nav = document.querySelector('.navigation');\r\n    const hamburger = document.querySelector('.hamburger');\r\n\r\n    hamburger.addEventListener('click' , () => {\r\n        nav.classList.toggle('show');\r\n    })\r\n}\r\n\r\nfunction app() {\r\n    slider()\r\n    navbar()\r\n}\r\n\r\napp()"},"lineCount":null}},"error"